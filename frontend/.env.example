VITE_MEANT_API_URL=http://localhost:8080
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Public Turnstile site key used by the anonymous-auth challenge in hosted environments.
VITE_TURNSTILE_SITE_KEY=
VITE_EMBEDDED_CHECKOUT_ENABLED=false
VITE_CHECKOUT_KIT_DEBUG=false
# Public PostHog browser token and EU ingestion host. Analytics runs only in production builds.
VITE_POSTHOG_ENABLED=false
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=
# Replay has stricter privacy/consent requirements and remains explicitly disabled by default.
VITE_POSTHOG_SESSION_REPLAY_ENABLED=false
VITE_POSTHOG_SESSION_REPLAY_SAMPLE_RATE=0.05
