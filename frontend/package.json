{
  "name": "meant-web",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 3000",
    "test": "bun test",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "build": "vite build && tsc --noEmit",
    "serve": "vite preview --host 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit",
    "gen:api": "openapi-typescript http://localhost:8080/v3/api-docs -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@shopify/checkout-kit": "4.0.0-alpha.2",
    "@supabase/supabase-js": "2.112.0",
    "@tanstack/react-router": "^1.170.19",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/react-start": "^1.168.36",
    "openapi-fetch": "^0.17.0",
    "posthog-js": "^1.412.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "brace-expansion": "2.1.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "minimatch": "10.2.6",
    "nitro": "3.0.260610-beta",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0"
  },
  "overrides": {
    "js-yaml": "4.3.1"
  }
}
