      "com.meant.api.module.cart.service.EmbeddedCheckoutBootstrapServiceTest#repeatedOpenedAcknowledgementsUseTheSameAttemptAndRemainIdempotentAtTheAttributionBoundary",
      "com.meant.api.module.checkout.service.CheckoutPurchaseAttributionServiceIT#concurrentDuplicateCallbacksCommitOneLedgerAndOneInventoryProjection",
