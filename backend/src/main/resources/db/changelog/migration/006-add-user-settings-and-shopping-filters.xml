    <changeSet id="003-create-user-settings" author="meant">
        <createTable tableName="user_settings">
            <column name="user_id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="budget" type="integer"/>
            <column name="location_country" type="text"/>
            <column name="location_code" type="text"/>
            <column name="location_city" type="text"/>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="user_settings"
                baseColumnNames="user_id"
                referencedTableName="users"
                referencedColumnNames="id"
                constraintName="fk_user_settings_user"/>
    </changeSet>

    <changeSet id="004-create-user-shopping-filters" author="meant">
        <createTable tableName="user_shopping_filters">
            <column name="user_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="filter_id" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey
                tableName="user_shopping_filters"
                columnNames="user_id, filter_id"
                constraintName="pk_user_shopping_filters"/>
        <addForeignKeyConstraint
                baseTableName="user_shopping_filters"
                baseColumnNames="user_id"
                referencedTableName="users"
                referencedColumnNames="id"
                constraintName="fk_user_shopping_filters_user"/>
        <addForeignKeyConstraint
                baseTableName="user_shopping_filters"
                baseColumnNames="filter_id"
                referencedTableName="shopping_filters"
                referencedColumnNames="id"
                constraintName="fk_user_shopping_filters_filter"/>
    </changeSet>

    <changeSet id="005-create-product-shopping-filters" author="meant">
        <createTable tableName="product_shopping_filters">
            <column name="product_key" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="filter_id" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="source" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="match_type" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="confidence" type="double precision"/>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey
                tableName="product_shopping_filters"
                columnNames="product_key, filter_id, source"
                constraintName="pk_product_shopping_filters"/>
        <addForeignKeyConstraint
                baseTableName="product_shopping_filters"
                baseColumnNames="filter_id"
                referencedTableName="shopping_filters"
                referencedColumnNames="id"
                constraintName="fk_product_shopping_filters_filter"/>
    </changeSet>
