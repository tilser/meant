<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="055-index-user-canonical-product-offer-references" author="codex">
        <createIndex
                tableName="user_canonical_product_references"
                indexName="idx_user_canonical_product_references_offer">
            <column name="user_id"/>
            <column name="offer_key"/>
            <column name="reference_verified_at" descending="true"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
