<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-create-merchant-raw" author="codex">
        <createTable tableName="merchant_raw">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="dataset_row_idx" type="int">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="domain" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="ucp_url" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="http_status" type="int"/>
            <column name="ucp_version" type="text"/>
            <column name="has_checkout" type="boolean">
                <constraints nullable="false"/>
            </column>
            <column name="has_identity_linking" type="boolean">
                <constraints nullable="false"/>
            </column>
            <column name="has_cart_management" type="boolean">
                <constraints nullable="false"/>
            </column>
            <column name="has_order" type="boolean">
                <constraints nullable="false"/>
            </column>
            <column name="has_payment_token" type="boolean">
                <constraints nullable="false"/>
            </column>
            <column name="capability_count" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="ai_bot_policies" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="transports" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="last_checked_at" type="timestamp with time zone"/>
            <column name="last_success_at" type="timestamp with time zone"/>
            <column name="fetched_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="002-add-merchant-raw-domain-unique-constraint" author="codex">
        <addUniqueConstraint
                tableName="merchant_raw"
                columnNames="domain"
                constraintName="uk_merchant_raw_domain"/>
    </changeSet>
</databaseChangeLog>
