<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-add-search-retention-policy-state" author="meant">
        <addColumn tableName="user_product_searches">
            <column name="retention_policy_fingerprint" type="text"/>
        </addColumn>
        <addColumn tableName="user_product_search_results">
            <column name="source_provider" type="text"/>
            <column name="source_type" type="text"/>
            <column name="source_identity" type="text"/>
        </addColumn>
        <!-- Existing rows intentionally remain null and are rejected by the runtime policy validator. -->
    </changeSet>

    <changeSet id="002-add-saved-product-rehydration-reference" author="meant">
        <addColumn tableName="user_saved_products">
            <column name="source_provider" type="text"/>
            <column name="source_type" type="text"/>
            <column name="source_identity" type="text"/>
            <column name="local_merchant_id" type="uuid"/>
            <column name="merchant_integration_id" type="uuid"/>
            <column name="external_merchant_id" type="text"/>
            <column name="external_product_id" type="text"/>
            <column name="external_variant_id" type="text"/>
            <column name="selected_options_json" type="text"/>
            <column name="retention_policy_key" type="text"/>
            <column name="reference_verified_at" type="timestamp with time zone"/>
        </addColumn>
        <dropNotNullConstraint tableName="user_saved_products" columnName="name" columnDataType="text"/>
        <dropNotNullConstraint tableName="user_saved_products" columnName="brand" columnDataType="text"/>
        <dropNotNullConstraint tableName="user_saved_products" columnName="category" columnDataType="text"/>
        <dropNotNullConstraint tableName="user_saved_products" columnName="tone" columnDataType="text"/>
        <dropNotNullConstraint tableName="user_saved_products" columnName="remote" columnDataType="boolean"/>
        <dropNotNullConstraint tableName="user_saved_products" columnName="match_score" columnDataType="integer"/>
        <dropNotNullConstraint tableName="user_saved_products" columnName="price_from" columnDataType="double precision"/>
        <dropNotNullConstraint tableName="user_saved_products" columnName="merchant_count" columnDataType="integer"/>
        <dropNotNullConstraint tableName="user_saved_products" columnName="satisfies" columnDataType="text"/>
        <dropNotNullConstraint tableName="user_saved_products" columnName="misses" columnDataType="text"/>
        <dropNotNullConstraint tableName="user_saved_products" columnName="note" columnDataType="text"/>
        <dropNotNullConstraint tableName="user_saved_products" columnName="pros" columnDataType="text"/>
        <dropNotNullConstraint tableName="user_saved_products" columnName="cons" columnDataType="text"/>
        <dropNotNullConstraint tableName="user_saved_products" columnName="review_score" columnDataType="double precision"/>
        <dropNotNullConstraint tableName="user_saved_products" columnName="review_count" columnDataType="integer"/>
        <dropNotNullConstraint tableName="user_saved_products" columnName="review_insight" columnDataType="text"/>
        <dropNotNullConstraint tableName="user_saved_products" columnName="offers" columnDataType="text"/>
        <dropNotNullConstraint tableName="user_saved_products" columnName="provides" columnDataType="text"/>
        <!-- Historical rows have no reviewed reference. Erase all catalog/search/commercial/media/review snapshots. -->
        <update tableName="user_saved_products">
            <column name="product_hash" valueComputed="NULL"/>
            <column name="name" valueComputed="NULL"/>
            <column name="brand" valueComputed="NULL"/>
            <column name="category" valueComputed="NULL"/>
            <column name="tone" valueComputed="NULL"/>
            <column name="image_url" valueComputed="NULL"/>
            <column name="product_url" valueComputed="NULL"/>
            <column name="remote" valueComputed="NULL"/>
            <column name="match_score" valueComputed="NULL"/>
            <column name="price_from" valueComputed="NULL"/>
            <column name="merchant_count" valueComputed="NULL"/>
            <column name="satisfies" valueComputed="NULL"/>
            <column name="misses" valueComputed="NULL"/>
            <column name="note" valueComputed="NULL"/>
            <column name="pros" valueComputed="NULL"/>
            <column name="cons" valueComputed="NULL"/>
            <column name="review_score" valueComputed="NULL"/>
            <column name="review_count" valueComputed="NULL"/>
            <column name="review_insight" valueComputed="NULL"/>
            <column name="offers" valueComputed="NULL"/>
            <column name="needs" valueComputed="NULL"/>
            <column name="provides" valueComputed="NULL"/>
        </update>
        <sql>
            ALTER TABLE user_saved_products
            ADD CONSTRAINT ck_user_saved_products_verified_reference
            CHECK (
                reference_verified_at IS NULL OR (
                    source_provider IS NOT NULL
                    AND source_type IS NOT NULL
                    AND source_identity IS NOT NULL
                    AND external_product_id IS NOT NULL
                    AND selected_options_json IS NOT NULL
                    AND retention_policy_key IS NOT NULL
                )
            )
        </sql>
        <sql>
            ALTER TABLE user_saved_products
            ADD CONSTRAINT ck_user_saved_products_identifier_only
            CHECK (
                product_hash IS NULL
                AND name IS NULL
                AND brand IS NULL
                AND category IS NULL
                AND tone IS NULL
                AND image_url IS NULL
                AND product_url IS NULL
                AND remote IS NULL
                AND match_score IS NULL
                AND price_from IS NULL
                AND merchant_count IS NULL
                AND satisfies IS NULL
                AND misses IS NULL
                AND note IS NULL
                AND pros IS NULL
                AND cons IS NULL
                AND review_score IS NULL
                AND review_count IS NULL
                AND review_insight IS NULL
                AND offers IS NULL
                AND needs IS NULL
                AND provides IS NULL
            )
        </sql>
    </changeSet>
</databaseChangeLog>
