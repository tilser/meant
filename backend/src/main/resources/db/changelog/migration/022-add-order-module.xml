<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-create-order-module" author="codex">
        <createTable tableName="merchant_order">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="uuid"/>
            <column name="merchant_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="merchant_domain" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="merchant_name" type="text"/>
            <column name="endpoint" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="remote_order_id" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="remote_order_id_hash" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="order_name" type="text"/>
            <column name="order_number" type="text"/>
            <column name="state" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="remote_financial_status" type="text"/>
            <column name="remote_fulfillment_status" type="text"/>
            <column name="customer_email" type="text"/>
            <column name="order_status_url" type="text"/>
            <column name="raw_order_response" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="total_amount" type="text"/>
            <column name="subtotal_amount" type="text"/>
            <column name="currency" type="text"/>
            <column name="total_quantity" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="placed_at" type="timestamp with time zone"/>
            <column name="remote_updated_at" type="timestamp with time zone"/>
            <column name="processed_at" type="timestamp with time zone"/>
            <column name="canceled_at" type="timestamp with time zone"/>
            <column name="closed_at" type="timestamp with time zone"/>
            <column name="last_webhook_id" type="text"/>
            <column name="last_webhook_topic" type="text"/>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="refreshed_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="merchant_order"
                baseColumnNames="user_id"
                constraintName="fk_merchant_order_user"
                referencedTableName="users"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                baseTableName="merchant_order"
                baseColumnNames="merchant_id"
                constraintName="fk_merchant_order_merchant"
                referencedTableName="merchant"
                referencedColumnNames="id"/>
        <addUniqueConstraint
                tableName="merchant_order"
                columnNames="merchant_id, remote_order_id_hash"
                constraintName="uk_merchant_order_remote"/>
        <createIndex tableName="merchant_order" indexName="idx_merchant_order_user">
            <column name="user_id"/>
            <column name="placed_at"/>
        </createIndex>
        <createIndex tableName="merchant_order" indexName="idx_merchant_order_customer_email">
            <column name="customer_email"/>
        </createIndex>
    </changeSet>

    <changeSet id="002-create-order-lines" author="codex">
        <createTable tableName="merchant_order_line">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="order_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="remote_order_line_id" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="product_id" type="text"/>
            <column name="product_title" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="product_variant_id" type="text"/>
            <column name="variant_title" type="text"/>
            <column name="sku" type="text"/>
            <column name="vendor" type="text"/>
            <column name="image_url" type="text"/>
            <column name="product_url" type="text"/>
            <column name="quantity" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="unit_amount" type="text"/>
            <column name="total_amount" type="text"/>
            <column name="currency" type="text"/>
            <column name="raw_line_response" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="merchant_order_line"
                baseColumnNames="order_id"
                constraintName="fk_merchant_order_line_order"
                referencedTableName="merchant_order"
                referencedColumnNames="id"/>
        <addUniqueConstraint
                tableName="merchant_order_line"
                columnNames="order_id, remote_order_line_id"
                constraintName="uk_merchant_order_line_remote"/>
    </changeSet>
</databaseChangeLog>
