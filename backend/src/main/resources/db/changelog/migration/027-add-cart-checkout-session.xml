<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-add-cart-checkout-session" author="codex">
        <addColumn tableName="cart">
            <column name="checkout_id" type="text"/>
            <column name="checkout_status" type="text"/>
            <column name="raw_checkout_response" type="text"/>
        </addColumn>
        <createIndex tableName="cart" indexName="idx_cart_checkout_id">
            <column name="checkout_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
