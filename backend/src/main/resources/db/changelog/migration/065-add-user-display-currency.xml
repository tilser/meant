<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-add-user-display-currency" author="meant">
        <addColumn tableName="user_settings">
            <column name="currency" type="text" defaultValue="USD">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <dropDefaultValue tableName="user_settings" columnName="currency" columnDataType="text"/>
    </changeSet>
</databaseChangeLog>
