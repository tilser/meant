<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-create-discount-code-search" author="codex">
        <createTable tableName="discount_code_search">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="merchant_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="merchant_domain" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="searched_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="source_count" type="integer"/>
            <column name="error_message" type="text"/>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="discount_code_search"
                baseColumnNames="merchant_id"
                constraintName="fk_discount_code_search_merchant"
                referencedTableName="merchant"
                referencedColumnNames="id"/>
        <createIndex tableName="discount_code_search" indexName="idx_discount_code_search_merchant_expires">
            <column name="merchant_id"/>
            <column name="expires_at"/>
        </createIndex>
        <createIndex tableName="discount_code_search" indexName="idx_discount_code_search_merchant_domain">
            <column name="merchant_domain"/>
        </createIndex>
    </changeSet>

    <changeSet id="002-create-discount-code-candidate" author="codex">
        <createTable tableName="discount_code_candidate">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="search_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="merchant_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="code" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="text"/>
            <column name="description" type="text"/>
            <column name="source_url" type="text"/>
            <column name="confidence" type="double precision"/>
            <column name="restrictions" type="text"/>
            <column name="valid_from_text" type="text"/>
            <column name="valid_until_text" type="text"/>
            <column name="valid_until" type="timestamp with time zone"/>
            <column name="validated_at" type="timestamp with time zone"/>
            <column name="expires_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="validation_message" type="text"/>
            <column name="display_order" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="discount_code_candidate"
                baseColumnNames="search_id"
                constraintName="fk_discount_code_candidate_search"
                referencedTableName="discount_code_search"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                baseTableName="discount_code_candidate"
                baseColumnNames="merchant_id"
                constraintName="fk_discount_code_candidate_merchant"
                referencedTableName="merchant"
                referencedColumnNames="id"/>
        <addUniqueConstraint
                tableName="discount_code_candidate"
                columnNames="search_id, code"
                constraintName="uk_discount_code_candidate_search_code"/>
        <createIndex tableName="discount_code_candidate" indexName="idx_discount_code_candidate_merchant_status_expires">
            <column name="merchant_id"/>
            <column name="status"/>
            <column name="expires_at"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
