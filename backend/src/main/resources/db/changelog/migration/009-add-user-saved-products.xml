<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-create-user-saved-products" author="meant">
        <createTable tableName="user_saved_products">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="product_key" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="product_hash" type="text"/>
            <column name="name" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="brand" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="category" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="tone" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="image_url" type="text"/>
            <column name="product_url" type="text"/>
            <column name="remote" type="boolean">
                <constraints nullable="false"/>
            </column>
            <column name="match_score" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="price_from" type="double precision">
                <constraints nullable="false"/>
            </column>
            <column name="merchant_count" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="satisfies" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="misses" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="note" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="pros" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="cons" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="review_score" type="double precision">
                <constraints nullable="false"/>
            </column>
            <column name="review_count" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="review_insight" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="offers" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="needs" type="text"/>
            <column name="provides" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="user_saved_products"
                baseColumnNames="user_id"
                referencedTableName="users"
                referencedColumnNames="id"
                onDelete="CASCADE"
                constraintName="fk_user_saved_products_user"/>
        <addUniqueConstraint
                tableName="user_saved_products"
                columnNames="user_id, product_key"
                constraintName="uk_user_saved_products_user_product"/>
        <createIndex
                tableName="user_saved_products"
                indexName="idx_user_saved_products_user_created">
            <column name="user_id"/>
            <column name="created_at"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
