    {
      "name": "Carts",
      "item": [
        {
          "name": "Create Cart",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.cartId) pm.collectionVariables.set('cartId', body.cartId);",
                  "if (body.checkoutUrl) pm.collectionVariables.set('checkoutUrl', body.checkoutUrl);",
                  "if (body.lines && body.lines.length > 0) {",
                  "  pm.collectionVariables.set('cartLineId', body.lines[0].cartLineId);",
                  "  pm.collectionVariables.set('remoteCartLineId', body.lines[0].remoteCartLineId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"merchantId\": null,\n  \"merchantDomain\": \"{{merchantDomain}}\",\n  \"addItems\": [\n    {\n      \"productVariantId\": \"{{productVariantId}}\",\n      \"quantity\": 1\n    }\n  ],\n  \"buyerIdentity\": null,\n  \"deliveryAddressesToAdd\": [],\n  \"deliveryAddressesToReplace\": [],\n  \"selectedDeliveryOptions\": [],\n  \"discountCodes\": [],\n  \"giftCardCodes\": [],\n  \"note\": \"Created from Postman\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/carts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "carts"
              ]
            },
            "description": "merchantId is preferred for production-like calls. This example uses merchantDomain for testing convenience; set merchantId to a UUID and merchantDomain to null when you want to target a specific local merchant row."
          }
        },
        {
          "name": "Get Cart",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/carts/{{cartId}}?refresh=false",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "carts",
                "{{cartId}}"
              ],
              "query": [
                {
                  "key": "refresh",
                  "value": "false"
                }
              ]
            }
          }
        },
        {
          "name": "Refresh Cart",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/carts/{{cartId}}?refresh=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "carts",
                "{{cartId}}"
              ],
              "query": [
                {
                  "key": "refresh",
                  "value": "true"
                }
              ]
            }
          }
        },
        {
          "name": "Add Item To Cart",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.checkoutUrl) pm.collectionVariables.set('checkoutUrl', body.checkoutUrl);",
                  "if (body.lines && body.lines.length > 0) {",
                  "  pm.collectionVariables.set('cartLineId', body.lines[0].cartLineId);",
                  "  pm.collectionVariables.set('remoteCartLineId', body.lines[0].remoteCartLineId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"addItems\": [\n    {\n      \"productVariantId\": \"{{productVariantId}}\",\n      \"quantity\": 1\n    }\n  ],\n  \"updateItems\": [],\n  \"removeCartLineIds\": [],\n  \"removeRemoteCartLineIds\": [],\n  \"buyerIdentity\": null,\n  \"deliveryAddressesToAdd\": [],\n  \"deliveryAddressesToReplace\": [],\n  \"selectedDeliveryOptions\": [],\n  \"discountCodes\": [],\n  \"giftCardCodes\": [],\n  \"note\": \"Updated from Postman\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/carts/{{cartId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "carts",
                "{{cartId}}"
              ]
            }
          }
        },
        {
          "name": "Update Cart Line Quantity",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.checkoutUrl) pm.collectionVariables.set('checkoutUrl', body.checkoutUrl);"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"addItems\": [],\n  \"updateItems\": [\n    {\n      \"cartLineId\": \"{{cartLineId}}\",\n      \"remoteCartLineId\": null,\n      \"quantity\": 2\n    }\n  ],\n  \"removeCartLineIds\": [],\n  \"removeRemoteCartLineIds\": [],\n  \"buyerIdentity\": null,\n  \"deliveryAddressesToAdd\": [],\n  \"deliveryAddressesToReplace\": [],\n  \"selectedDeliveryOptions\": [],\n  \"discountCodes\": [],\n  \"giftCardCodes\": [],\n  \"note\": \"Quantity updated from Postman\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/carts/{{cartId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "carts",
                "{{cartId}}"
              ]
            }
          }
        },
